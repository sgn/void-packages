# Template file for 'slf4j'
pkgname=slf4j
version=2.0.16
revision=1
hostmakedepends="openjdk11 apache-maven"
depends="virtual?java-runtime"
short_desc="Simple Logging Facade for Java"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="MIT"
homepage="https://www.slf4j.org"
distfiles="https://github.com/qos-ch/slf4j/archive/refs/tags/v_${version}.tar.gz"
checksum=a0359ba6b14149ac76ce3384e77cecbe9a60507bec69ec2c04c6b60f92a102c2

post_patch() {
	sed -i '/module.integration/d' pom.xml
}

do_build() {
	mvn package -Dmaven.test.skip=true
}

do_install() {
	local p
	for p in slf4j-api slf4j-ext slf4j-simple slf4j-nop slf4j-reload4j \
		slf4j-migrator \
		slf4j-jdk14 slf4j-jdk-platform-logging \
		jul-to-slf4j \
		jcl-over-slf4j log4j-over-slf4j osgi-over-slf4j
	do
		vinstall "$p/target/$p-${version}.jar" 644 usr/share/java
		ln -s "$p-$version.jar" "$DESTDIR/usr/share/java/$p.jar"
	done
	vlicense LICENSE.txt
}
