		vmove usr/lib/purple-3
		vmove "usr/lib/girepository-1.0/Purple*"
		vmove "usr/share/glib-2.0/schemas/im.pidgin.Purple*"
	}
}

libpurple3-devel_package() {
	short_desc="GLib based messaging libraries - development files"
	pkg_install() {
		vmove usr/include/purple-3
		vmove "usr/lib/libpurple3.so"
		vmove usr/lib/pkgconfig/purple-3.pc
		vmove "usr/share/gir-1.0/Purple*"
	}
}
